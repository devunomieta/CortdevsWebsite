# Supabase Database & Auth Configuration
VITE_SUPABASE_URL=YOUR_SUPABASE_URL_HERE
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# Application Base URL (Used for generating email links)
VITE_APP_URL=http://localhost:5173

# Email Service - Resend (Primary API)
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE

# Email Service - SMTP Fallback
SMTP_HOST=YOUR_SMTP_HOST_HERE
SMTP_PORT=465
SMTP_USER=YOUR_SMTP_USER_HERE
SMTP_PASS=YOUR_SMTP_PASS_HERE
SMTP_FROM_NAME=CortDevs System

# Development Server (Optional)
API_PORT=3000

# Events Portal — signs the event-owner dashboard session tokens (api/_lib/eventAuth.ts).
# Freshly generated below — safe to copy as-is, or generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it invalidates every active event-dashboard session.
EVENTS_TOKEN_SECRET=

# Events Portal — shared secret Vercel Cron sends as `Authorization: Bearer <value>`
# when it calls /api/cron/event-retention. Set the same value in the Vercel project's
# environment variables; without it the retention job runs unauthenticated.
CRON_SECRET=
