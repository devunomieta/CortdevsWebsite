{
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/router?path=:path*"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/event-retention",
            "schedule": "0 9 * * *"
        }
    ]
}