{
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/router?path=:path*"
        },
        {
            "source": "/((?!api/).*)",
            "has": [{ "type": "host", "value": "splitsubs.cortdevs.com" }],
            "destination": "/splitsubs.html"
        },
        {
            "source": "/((?!api/).*)",
            "has": [{ "type": "host", "value": "learn.cortdevs.com" }],
            "destination": "/learn.html"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/event-retention",
            "schedule": "0 9 * * *"
        },
        {
            "path": "/api/cron/splitsubs-escrow-release",
            "schedule": "0 10 * * *"
        },
        {
            "path": "/api/cron/splitsubs-renewal-reminders",
            "schedule": "0 8 * * *"
        },
        {
            "path": "/api/cron/lms-daily-reminders",
            "schedule": "0 7 * * *"
        },
        {
            "path": "/api/cron/lms-weekly-digest",
            "schedule": "0 6 * * 1"
        }
    ]
}